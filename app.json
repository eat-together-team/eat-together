{
  "expo": {
    "name": "Eat Together!",
    "owner": "eat-together-team",
    "slug": "eat-together",
    "description": "Connecting students through shared meals.",
    "version": "1.4.1",
    "sdkVersion": "53.0.0",
    "orientation": "portrait",
    "icon": "./assets/big_logo.png",
    "scheme": "com.eat.together",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#73AE7B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.eat.together",
      "versionCode": 37,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "MEDIA_LIBRARY",
        "MEDIA_LIBRARY_WRITE_ONLY"
      ],
      "runtimeVersion": "1.0.0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eat.together",
      "buildNumber": "21",
      "icon": {
        "light": "./assets/big_logo.png",
        "dark": "./assets/dark_logo.png",
        "tinted": "./assets/dark_logo.png"
      }
    },
    "web": {
      "favicon": "./assets/big_logo.png"
    },
    "runtimeVersion": "1.0.0",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you pick a profile image."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "605daf62-9a09-4742-8204-1f8dfb5e4363"
      }
    }
  }
}